# Configuração do Servidor
PORT=3000

# Configuração do Telegram Bot para Alertas de Baixa de Preço
# 1. Cria o teu bot com o @BotFather no Telegram e obtém o BOT_TOKEN
# 2. Obtém o teu Chat ID enviando uma mensagem para @userinfobot no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configuração do Agendamento (4 vezes ao dia por padrão: 00:00, 06:00, 12:00, 18:00)
# Expressão cron: minuto hora dia-do-mês mês dia-da-semana
CRON_SCHEDULE=0 0,6,12,18 * * *

# Limiar de Alerta (Opcional - se definido, alerta também se o preço descer abaixo deste valor)
ALERT_TARGET_PRICE=380.00
